# Copy to .env and fill in. Real environment variables override this file,
# so production can inject config without editing anything on disk.
#
#   cp .env.example .env

# ---------------------------------------------------------------- templates
# Drive file IDs of the master templates. These win over templates.json, so in
# production this is the only thing you need to change to point at a new deck.
# Get them from setup_template.py, or from the URL:
#   https://docs.google.com/presentation/d/<THIS_PART>/edit
DOCGEN_PRESENTATION_TEMPLATE_ID=
DOCGEN_BROCHURE_TEMPLATE_ID=

# Drive folder that generated files are placed in -- decks, brochures and
# uploaded .docx alike. Leave blank for My Drive root. Set this to a shared
# folder so the team can find what the tool produces.
# A full folder URL works as well as a bare ID:
#   https://drive.google.com/drive/folders/<THIS_PART>
DOCGEN_OUTPUT_FOLDER_ID=

# The catalog brochure is a local .docx filled on disk, not a Drive master.
# Defaults to Agentic_AI_Brochure_Template.docx next to the code; override to
# point at your own revision of the template.
# DOCGEN_BROCHURE_DOCX=/etc/docgen/Agentic_AI_Brochure_Template.docx

# ---------------------------------------------------------------- credentials
# Defaults to the project folder. Point these elsewhere in production, e.g. at
# a mounted secrets volume.
# DOCGEN_CONFIG_DIR=/etc/docgen
# DOCGEN_CREDENTIALS=/etc/docgen/credentials.json
# DOCGEN_TOKEN=/etc/docgen/token.json
# DOCGEN_TEMPLATES=/etc/docgen/templates.json

# Load a different .env entirely (set as a real env var, not here).
# DOCGEN_ENV_FILE=/etc/docgen/.env
